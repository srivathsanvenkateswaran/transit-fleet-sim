# Service
PORT=8080
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:8080
QR_PATH_PREFIX=/b/
LOG_LEVEL=info
LOG_FORMAT=json
CORS_ALLOWED_ORIGINS=*
ADMIN_TOKEN=
REQUEST_TIMEOUT_MS=5000

# Simulation
SIM_SEED=1
SIM_TICK_MS=1000
SIM_TIMEZONE=Asia/Kolkata
SIM_CLOCK=system
SIM_SPEEDUP=1
SIM_ALLOW_TIME_TRAVEL=false

# Fleet composition
BUS_ROUTES=500-D,500-A,G-4,335-E,401-K,KIA-4,KIA-8,KIA-9,KIA-10,KIA-15
BUSES_PER_ROUTE=6
BUS_HUB_CODE=BLR
BUS_TERMINAL_LAYOVER_SECONDS=300
METRO_LINES=purple,green,yellow
METRO_TRAINS_PER_LINE=
METRO_HUB_CODE=MTR
METRO_TURNAROUND_SECONDS=240

# Honesty knobs
BUS_FIX_INTERVAL_SECONDS=20
BUS_FIX_JITTER_SECONDS=10
BUS_STALE_AFTER_SECONDS=90
BUS_DARK_AFTER_SECONDS=300
BUS_COVERAGE_SHARE=0.75
BUS_DROPOUT_RATE_PER_HOUR=1.5
BUS_DROPOUT_MIN_SECONDS=60
BUS_DROPOUT_MAX_SECONDS=420
BUS_GPS_NOISE_METRES=12
BUS_SEATED_CAPACITY=42
BUS_STANDING_CAPACITY=38
BUS_AIRPORT_SEATED_CAPACITY=45
BUS_AIRPORT_STANDING_CAPACITY=8
METRO_FIX_INTERVAL_SECONDS=5
METRO_STALE_AFTER_SECONDS=30
METRO_DARK_AFTER_SECONDS=120
METRO_COVERAGE_SHARE=1.0
METRO_DROPOUT_RATE_PER_HOUR=0.05
METRO_POSITION_NOISE_METRES=2
METRO_BLOCK_LENGTH_METRES=200

# Duty and roster uncertainty
DUTY_CONFIRMED_SHARE=0.60
DUTY_INFERRED_SHARE=0.25
DUTY_UNKNOWN_SHARE=0.10
DUTY_OUT_OF_SERVICE_SHARE=0.05
DUTY_INFERRED_CONFIDENCE_MIN=0.55
DUTY_INFERRED_CONFIDENCE_MAX=0.95
DUTY_SWAP_RATE_PER_DAY=0.15
METRO_DUTY_CONFIRMED_SHARE=0.99
METRO_DUTY_SWAP_RATE_PER_DAY=0

# Speed and headway
BUS_SPEED_KPH_MEAN=17
BUS_SPEED_KPH_SD=4
BUS_SPEED_KPH_MIN=5
BUS_SPEED_KPH_MAX=45
BUS_DWELL_SECONDS_MEAN=20
BUS_DWELL_SECONDS_SD=8
BUS_PEAK_SPEED_FACTOR=0.7
BUS_PEAK_WINDOWS=07:00-10:00,17:00-21:00
METRO_CRUISE_KPH=60
METRO_ACCEL_MPS2=1.0
METRO_DECEL_MPS2=1.1
METRO_DWELL_SECONDS=25
METRO_DWELL_SECONDS_SD=4
METRO_HEADWAY_SECONDS_PEAK=480
METRO_HEADWAY_SECONDS_OFFPEAK=720
METRO_HEADWAY_SECONDS_PEAK__YELLOW=540
METRO_HEADWAY_SECONDS_OFFPEAK__YELLOW=840
METRO_HEADWAY_JITTER_SECONDS=20

# Predictions and feeds
PUBLISH_TRIP_UPDATES=true
PREDICTION_HORIZON_STOPS=5
PREDICTION_UNCERTAINTY_BASE_SECONDS=45
PREDICTION_UNCERTAINTY_PER_STOP_SECONDS=30
METRO_PREDICTION_UNCERTAINTY_BASE_SECONDS=15
METRO_PREDICTION_UNCERTAINTY_PER_STOP_SECONDS=5
TRIP_UPDATES_OMIT_UNTRACKED=false
FEED_TTL_SECONDS=15

# Data
GTFS_SOURCE=bundled
GTFS_BUNDLE_PATH=./data/bundle
GTFS_PATH=
GTFS_URL=
GTFS_CACHE_DIR=./.cache/gtfs
METRO_TOPOLOGY_PATH=./data/bundle/metro-topology.json
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_API_BASE_URL=https://api.openstreetmap.org/api/0.6
CITY_BBOX=12.7,77.3,13.2,77.9
GEOMETRY_MAX_STOP_OFFSET_METRES=150
METRO_MAX_STATION_GAP_METRES=4000

# Intercity coaches (docs/intercity-coaches.md). Unset INTERCITY_CORRIDORS
# means no coaches at all - the corridor files are not read and no new field
# appears on any response (§14.1).
INTERCITY_CORRIDORS=
INTERCITY_TOPOLOGY_PATH=./data/bundle/corridor-topology.json
INTERCITY_ROSTER_PATH=./data/bundle/corridor-roster.json
INTERCITY_ROSTER_DAYS=3
INTERCITY_ASSIGNMENT_HORIZON_HOURS=36
INTERCITY_HUB_CODES=KBS,MYS,MDK,HUB,HSP
INTERCITY_SERVICE_CLASSES=karnataka_sarige,rajahamsa_executive,airavat,airavat_club_class,ambaari_utsav,pallakki

# Intercity device and coverage (§12.2). Better fitted, worse tracked: the
# reserved share is above the city bus's 0.75 and the ordinary share is below
# it, which makes the ruling one about service class rather than about mode.
# Every magnitude here is chosen rather than measured - see §17.2.
INTERCITY_COVERAGE_SHARE__RESERVED=0.92
INTERCITY_COVERAGE_SHARE__ORDINARY=0.70
INTERCITY_FIX_INTERVAL_SECONDS=30
INTERCITY_FIX_INTERVAL_STATIONARY_SECONDS=120
INTERCITY_FIX_JITTER_SECONDS=8
INTERCITY_STALE_AFTER_SECONDS=180
INTERCITY_DARK_AFTER_SECONDS=600
INTERCITY_GPS_NOISE_METRES=12

# Intercity dead zones (§12.3). Zone placement itself is build-time and lives
# in scripts/build-corridors.ts, because the zones are committed into
# corridor-topology.json and checked by the integrity gate.
INTERCITY_DEAD_ZONE_UNCERTAINTY_MULTIPLIER=2.5
INTERCITY_URBAN_DROPOUT_RATE_PER_HOUR=1.5

# Intercity halts and dwell (§12.4)
INTERCITY_BOARDING_SECONDS_MEAN=180
INTERCITY_BOARDING_SECONDS_SD=60
INTERCITY_STAND_SECONDS_MEAN=420
INTERCITY_STAND_SECONDS_SD=180
INTERCITY_HALT_SECONDS_MEAN=1800
INTERCITY_HALT_SECONDS_SD=420
INTERCITY_CREW_CHANGE_SECONDS_MEAN=420
INTERCITY_CREW_CHANGE_SECONDS_SD=120

# Intercity duty and substitution (§12.5). There is deliberately no
# INTERCITY_DUTY_SWAP_RATE_PER_DAY: §12.5 fixes it at 0 and not configurable
# upward, because a coach 200 km from the nearest depot cannot be reassigned
# mid-run. Vehicle substitution before departure is the mechanism instead.
INTERCITY_DUTY_CONFIRMED_SHARE=0.80
INTERCITY_DUTY_INFERRED_SHARE=0.15
INTERCITY_DUTY_UNKNOWN_SHARE=0.03
INTERCITY_DUTY_OUT_OF_SERVICE_SHARE=0.02
INTERCITY_VEHICLE_SUBSTITUTION_RATE_PER_DUTY=0.06

# Intercity speed, by segment kind (§12.6)
INTERCITY_CRUISE_KPH_MEAN=62
INTERCITY_CRUISE_KPH_SD=8
INTERCITY_CRUISE_KPH_MIN=30
INTERCITY_CRUISE_KPH_MAX=85
INTERCITY_URBAN_KPH_MEAN=17
INTERCITY_URBAN_KPH_SD=4

# Intercity predictions (§12.7)
INTERCITY_UNCERTAINTY_BASE_SECONDS=120
INTERCITY_UNCERTAINTY_PER_HIGHWAY_KM_SECONDS=1.5
INTERCITY_UNCERTAINTY_PER_HALT_SECONDS=420
INTERCITY_UNCERTAINTY_URBAN_APPROACH_SECONDS=600
INTERCITY_PREDICTION_HORIZON_SECONDS=21600
INTERCITY_SUGGESTED_POLL_SECONDS=120

# The manifest ingress (§12.8). MANIFEST_TOKEN is a different credential from
# ADMIN_TOKEN on purpose: the BPP is a peer, not an operator, and one shared
# credential would let a ticketing platform force a coach dark. Unset means
# PUT/DELETE /fleet/manifest is a 404, not a 401.
MANIFEST_TOKEN=
INTERCITY_MANIFEST_MAX_AGE_SECONDS=3600
INTERCITY_MANIFEST_TTL_MAX_SECONDS=86400
INTERCITY_PROGRESS_LOG_MAX_ENTRIES=40
