# Service
PORT=8080
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:8080
QR_PATH_PREFIX=/b/
LOG_LEVEL=info
LOG_FORMAT=json
CORS_ALLOWED_ORIGINS=*
ADMIN_TOKEN=
REQUEST_TIMEOUT_MS=5000

# Simulation
SIM_SEED=1
SIM_TICK_MS=1000
SIM_TIMEZONE=Asia/Kolkata
SIM_CLOCK=system
SIM_SPEEDUP=1
SIM_ALLOW_TIME_TRAVEL=false

# Fleet composition
BUS_ROUTES=500-D,500-A,G-4,335-E,401-K
BUSES_PER_ROUTE=6
BUS_HUB_CODE=BLR
BUS_TERMINAL_LAYOVER_SECONDS=300
METRO_LINES=purple,green,yellow
METRO_TRAINS_PER_LINE=
METRO_HUB_CODE=MTR
METRO_TURNAROUND_SECONDS=240

# Honesty knobs
BUS_FIX_INTERVAL_SECONDS=20
BUS_FIX_JITTER_SECONDS=10
BUS_STALE_AFTER_SECONDS=90
BUS_DARK_AFTER_SECONDS=300
BUS_COVERAGE_SHARE=0.75
BUS_DROPOUT_RATE_PER_HOUR=1.5
BUS_DROPOUT_MIN_SECONDS=60
BUS_DROPOUT_MAX_SECONDS=420
BUS_GPS_NOISE_METRES=12
METRO_FIX_INTERVAL_SECONDS=5
METRO_STALE_AFTER_SECONDS=30
METRO_DARK_AFTER_SECONDS=120
METRO_COVERAGE_SHARE=1.0
METRO_DROPOUT_RATE_PER_HOUR=0.05
METRO_POSITION_NOISE_METRES=2
METRO_BLOCK_LENGTH_METRES=200

# Duty and roster uncertainty
DUTY_CONFIRMED_SHARE=0.60
DUTY_INFERRED_SHARE=0.25
DUTY_UNKNOWN_SHARE=0.10
DUTY_OUT_OF_SERVICE_SHARE=0.05
DUTY_INFERRED_CONFIDENCE_MIN=0.55
DUTY_INFERRED_CONFIDENCE_MAX=0.95
DUTY_SWAP_RATE_PER_DAY=0.15
METRO_DUTY_CONFIRMED_SHARE=0.99
METRO_DUTY_SWAP_RATE_PER_DAY=0

# Speed and headway
BUS_SPEED_KPH_MEAN=17
BUS_SPEED_KPH_SD=4
BUS_SPEED_KPH_MIN=5
BUS_SPEED_KPH_MAX=45
BUS_DWELL_SECONDS_MEAN=20
BUS_DWELL_SECONDS_SD=8
BUS_PEAK_SPEED_FACTOR=0.7
BUS_PEAK_WINDOWS=07:00-10:00,17:00-21:00
METRO_CRUISE_KPH=60
METRO_ACCEL_MPS2=1.0
METRO_DECEL_MPS2=1.1
METRO_DWELL_SECONDS=25
METRO_DWELL_SECONDS_SD=4
METRO_HEADWAY_SECONDS_PEAK=480
METRO_HEADWAY_SECONDS_OFFPEAK=720
METRO_HEADWAY_SECONDS_PEAK__YELLOW=540
METRO_HEADWAY_SECONDS_OFFPEAK__YELLOW=840
METRO_HEADWAY_JITTER_SECONDS=20

# Predictions and feeds
PUBLISH_TRIP_UPDATES=true
PREDICTION_HORIZON_STOPS=5
PREDICTION_UNCERTAINTY_BASE_SECONDS=45
PREDICTION_UNCERTAINTY_PER_STOP_SECONDS=30
METRO_PREDICTION_UNCERTAINTY_BASE_SECONDS=15
METRO_PREDICTION_UNCERTAINTY_PER_STOP_SECONDS=5
TRIP_UPDATES_OMIT_UNTRACKED=false
FEED_TTL_SECONDS=15

# Data
GTFS_SOURCE=bundled
GTFS_BUNDLE_PATH=./data/bundle
GTFS_PATH=
GTFS_URL=
GTFS_CACHE_DIR=./.cache/gtfs
METRO_TOPOLOGY_PATH=./data/bundle/metro-topology.json
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_API_BASE_URL=https://api.openstreetmap.org/api/0.6
CITY_BBOX=12.7,77.3,13.2,77.9
GEOMETRY_MAX_STOP_OFFSET_METRES=150
METRO_MAX_STATION_GAP_METRES=4000
